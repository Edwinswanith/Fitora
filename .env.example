# Copy to .env at the repo root, or place server-specific values in server/.env.

# ----- Server -----
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/?appName=YourApp
MONGODB_DB=Fitora
AUTH_SECRET=replace_with_one_strong_secret_for_vercel
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ----- Notifications / Push -----
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=change_me_cron_secret
# Optional separate secret for POST /internal/notifications/sweep. If omitted,
# the server accepts CRON_SECRET for the internal sweep endpoint too.
# INTERNAL_SWEEP_SECRET=change_me_sweep_secret
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
NOTIFICATION_SWEEP_DEFAULT_LIMIT=200
NOTIFICATION_SWEEP_DEFAULT_PAGES=5
NOTIFICATION_DAILY_CAP=6
NOTIFICATION_MIN_INTERVAL_MINUTES=60
NOTIFICATION_QUIET_HOURS_DEFAULT_START=22:00
NOTIFICATION_QUIET_HOURS_DEFAULT_END=07:00
NOTIFICATION_PRESENCE_SUPPRESS_WINDOW_MIN=10
DAILY_CHECKIN_REMINDER_LOCAL_TIME=20:00
TRAINING_SESSION_REMINDER_AM_TIME=07:00
TRAINING_SESSION_REMINDER_AFT_TIME=12:00
TRAINING_SESSION_REMINDER_PM_TIME=16:00
RPE_MONITORING_REMINDER_AM_TIME=07:00
RPE_MONITORING_REMINDER_AFT_TIME=12:00
RPE_MONITORING_REMINDER_PM_TIME=16:00
HYDRATION_REMINDER_LOCAL_TIME=14:00
MISSED_ACTIVITY_REMINDER_LOCAL_TIME=08:00
NOTE_NEEDS_REPLY_HOURS=24
WEEKLY_SUMMARY_LOCAL_TIME=09:00
SQUAD_DIGEST_LOCAL_TIME=09:00

# Optional — coach media uploads. Defaults: ./uploads (relative to the server
# process cwd) and 8 MB per file.
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_MB=8

# Durable upload storage (Google Cloud Storage). Required on Cloud Run/Vercel,
# whose disks are wiped on every redeploy/restart. Leave empty for local dev.
# Credentials: GCS_SERVICE_ACCOUNT_JSON (needs Storage Object Admin on the
# bucket), or on Cloud Run leave it empty to use the service's own identity.
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_PREFIX=uploads/
# GCS_SERVICE_ACCOUNT_JSON=

# Optional — "Sign in with Google" token audience(s). Comma-separated list of
# Google OAuth client IDs (e.g. the web client ID plus the iOS client ID) —
# an ID token is accepted if its audience matches any of them. Empty disables
# the feature (POST /api/auth/google returns 503 google_signin_unconfigured).
# GOOGLE_CLIENT_ID=

# Optional — Apple Sign In token audience. Native iOS tokens use the bundle ID.
# APPLE_CLIENT_ID=app.apex.coaching

# Optional — Gemini vision, athlete voice-intent NLU, and guided-tour narration.
# Without a key, deterministic mocks/placeholders are used.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Ask Agent intent model (fast, thinking minimal). Defaults shown.
# GEMINI_VOICE_MODEL=gemini-3.1-flash-lite
# GEMINI_VOICE_THINKING=minimal

# Optional — Razorpay subscription payments (coach subscriptions, Phase 6).
# Without all three set, services/paymentProvider.ts runs a fully offline mock
# adapter — checkout, webhook, activation, and cancellation are all still
# exercisable/tested with no live merchant account.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional — LiveKit live video sessions (coach<->athlete calls, Phase 8).
# Without all three set, services/videoProvider.ts runs a fully offline mock
# adapter — join-token issuance and the room lifecycle are still exercisable/
# tested with no live LiveKit project. LIVEKIT_URL is the project's WebSocket
# URL (e.g. wss://your-project.livekit.cloud) from the LiveKit Cloud dashboard.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=

# Optional — mobile Ask Agent speech-to-text and text-to-speech.
# DEEP_GRAM=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-harmonia-en
# DEEPGRAM_STREAM_ENDPOINTING_MS=400
# DEEPGRAM_STREAM_UTTERANCE_END_MS=1000

# Production must override MONGODB_URI and AUTH_SECRET, or both JWT_ACCESS_SECRET
# and JWT_REFRESH_SECRET. Placeholder JWT secrets are rejected when NODE_ENV=production.

# ----- Web (Vercel) -----
# The static Expo web build intentionally leaves EXPO_PUBLIC_API_URL empty.
# Production web uses window.location.origin and calls the same-origin /api/* routes.

# ----- Mobile (Expo) -----
# Native iOS/Android production builds must point at the deployed Vercel URL.
# EXPO_PUBLIC_API_URL=https://your-vercel-domain.vercel.app
# In-app coach payments UI (subscribe/switch/payouts). Off unless "true".
# EXPO_PUBLIC_PAYMENTS_ENABLED=false
# Site hosting privacy.html/support.html for native builds (web uses its own origin).
# EXPO_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
