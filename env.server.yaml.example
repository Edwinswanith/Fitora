# Cloud Run environment variables for the Apex API server (scp-server).
# ----------------------------------------------------------------------------
# Copy this file to env.server.yaml, fill in real values, then run deploy.bat.
# env.server.yaml is gitignored so secrets never get committed.
#
# Each value MUST be a quoted string. Do NOT set PORT here -- Cloud Run injects
# it and the server reads process.env.PORT automatically.
#
# IMPORTANT: when MONGODB_URI points at a remote / Atlas database, the server
# REFUSES to start with placeholder JWT secrets. Use long, unique, random
# strings (32+ chars) for both secrets. Set CORS_ORIGIN only for browser-based
# Expo web testing; native iOS/Android clients are not CORS-gated.

NODE_ENV: "production"
MONGODB_URI: "mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/sports?retryWrites=true&w=majority"
JWT_ACCESS_SECRET: "REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET: "REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_ACCESS_TTL: "15m"
JWT_REFRESH_TTL: "30d"

# Scheduled notifications and Firebase Cloud Messaging.
# On Vercel, CRON_SECRET is also sent as Authorization: Bearer <CRON_SECRET>
# when the cron job invokes /api/cron/notifications-sweep.
CRON_SECRET: "REPLACE_WITH_RANDOM_CRON_SECRET"
# INTERNAL_SWEEP_SECRET: "OPTIONAL_DIFFERENT_INTERNAL_SWEEP_SECRET"
FCM_PROJECT_ID: ""
FCM_SERVICE_ACCOUNT_JSON: ""
NOTIFICATION_SWEEP_DEFAULT_LIMIT: "200"
NOTIFICATION_SWEEP_DEFAULT_PAGES: "5"
NOTIFICATION_DAILY_CAP: "6"
NOTIFICATION_MIN_INTERVAL_MINUTES: "60"
NOTIFICATION_QUIET_HOURS_DEFAULT_START: "22:00"
NOTIFICATION_QUIET_HOURS_DEFAULT_END: "07:00"
NOTIFICATION_PRESENCE_SUPPRESS_WINDOW_MIN: "10"
DAILY_CHECKIN_REMINDER_LOCAL_TIME: "20:00"
TRAINING_SESSION_REMINDER_AM_TIME: "07:00"
TRAINING_SESSION_REMINDER_AFT_TIME: "12:00"
TRAINING_SESSION_REMINDER_PM_TIME: "16:00"
RPE_MONITORING_REMINDER_AM_TIME: "07:00"
RPE_MONITORING_REMINDER_AFT_TIME: "12:00"
RPE_MONITORING_REMINDER_PM_TIME: "16:00"
HYDRATION_REMINDER_LOCAL_TIME: "14:00"
MISSED_ACTIVITY_REMINDER_LOCAL_TIME: "08:00"
NOTE_NEEDS_REPLY_HOURS: "24"
WEEKLY_SUMMARY_LOCAL_TIME: "09:00"
SQUAD_DIGEST_LOCAL_TIME: "09:00"

# "Sign in with Google" (existing accounts only). Leave empty to disable the
# feature. Add the Google client IDs used by the mobile app.
GOOGLE_CLIENT_ID: ""

# Sign in with Apple. Native iOS identity tokens use the iOS bundle identifier
# as the audience unless you configure a comma-separated APPLE_CLIENT_ID list.
APPLE_CLIENT_ID: "app.apex.coaching"

# Gemini — workout-image OCR, athlete voice-intent NLU, guided-tour narration.
# Leave empty to fall back to deterministic mocks. Create a key at Google AI
# Studio (aistudio.google.com/app/apikey). GEMINI_MODEL is optional.
GEMINI_API_KEY: ""
# GEMINI_MODEL: "gemini-2.5-flash"

# Deepgram — Ask Agent speech-to-text and text-to-speech. Keep this server-side;
# never bake it into the mobile app.
DEEP_GRAM: ""
# DEEPGRAM_STT_MODEL: "flux-general-multi"
# DEEPGRAM_TTS_MODEL: "aura-2-harmonia-en"
# DEEPGRAM_STREAM_ENDPOINTING_MS: "400"
# DEEPGRAM_STREAM_UTTERANCE_END_MS: "1000"
